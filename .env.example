# Agent provider conformance credentials
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; `.env.example`
# is the committed template and must never carry a real key.
#
# These drive the real-CLI conformance tests in `extensions/agent-*/test/
# conformance.test.mjs`. Each provider runs only when its own enable flag is
# `1` AND its CLI resolves on PATH; otherwise the test skips.
#
# In CI these become repository secrets, and a provider's job runs only when
# that extension's own files change.
#
# Every credential below is spent against a real account: these tests drive
# real model turns, real subagents, and real tool approvals. Use throwaway or
# scoped keys, never a personal login.

# ---------------------------------------------------------------------------
# Enable flags — one per provider. Nothing runs without these.
# ---------------------------------------------------------------------------
TERMINAY_CONFORMANCE_CLAUDE_CODE=
TERMINAY_CONFORMANCE_CODEX=
TERMINAY_CONFORMANCE_GROK=
TERMINAY_CONFORMANCE_OPENCODE=
TERMINAY_CONFORMANCE_CURSOR=
TERMINAY_CONFORMANCE_OMP=

# Prints each conformance step and the state after it. Useful in CI logs.
TERMINAY_CONFORMANCE_LOG=

# ---------------------------------------------------------------------------
# Claude Code — `claude`
# ---------------------------------------------------------------------------
# Confirmed: the CLI reads ANTHROPIC_API_KEY.
#
# Caveat already recorded in the Claude Code descriptor: with an API key in the
# environment the CLI asks whether to use it *before* it writes any journal, so
# a run can stall before there is anything to bind. Supply
# CLAUDE_CODE_CONFORMANCE_HOME below so the run gets its own $HOME with that
# approval pre-recorded, the way the Grok descriptor isolates GROK_HOME.
ANTHROPIC_API_KEY=

# Alternative to the API key for subscription auth. If both are set the OAuth
# token wins. Leave blank unless you are deliberately testing that path.
CLAUDE_CODE_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# Codex — `codex`
# ---------------------------------------------------------------------------
# Confirmed: the CLI reads OPENAI_API_KEY. The conformance descriptor already
# relies on this by launching `OPENAI_API_KEY=invalid codex` to provoke its
# halting fault.
OPENAI_API_KEY=

# Isolates the rollout store so a run never reads or writes ~/.codex.
# Leave blank to let the harness mint a temporary directory.
CODEX_HOME=

# ---------------------------------------------------------------------------
# Grok — `grok`
# ---------------------------------------------------------------------------
# NOT an API-key CLI as currently exercised. `isolatedGrokHome()` in the Grok
# descriptor copies `auth.json` out of a developer's `~/.grok`, which does not
# exist in CI. Supply the credential file's contents as a secret and the
# harness will write it into the isolated GROK_HOME.
#
# Get it from a machine where `grok` is already logged in:
#   cat ~/.grok/auth.json
GROK_AUTH_JSON=

# If the xAI key alone is enough to authenticate the CLI, set this instead and
# leave GROK_AUTH_JSON blank. UNVERIFIED — I have not confirmed the Grok CLI
# authenticates from an environment variable rather than auth.json.
XAI_API_KEY=

# ---------------------------------------------------------------------------
# OpenCode — `opencode`
# ---------------------------------------------------------------------------
# OpenCode authenticates per model provider rather than with its own key, and
# reads the same provider variables as above — the descriptor's fault gesture
# sets both OPENAI_API_KEY and ANTHROPIC_API_KEY to `invalid`. Set at least the
# one matching the model the run selects.
#
# Isolates the session store (`opencode.db`) so a run never touches the
# developer's. Leave blank to let the harness mint a temporary directory.
XDG_DATA_HOME=

# ---------------------------------------------------------------------------
# Cursor — `cursor-agent`
# ---------------------------------------------------------------------------
# UNVERIFIED. Cursor has no conformance descriptor yet; its only real-CLI test
# is a `--print` smoke test that never involves a PTY or the provider. This is
# the documented variable name, but I have not run the CLI against it, and the
# descriptor that will consume it does not exist yet.
CURSOR_API_KEY=

# ---------------------------------------------------------------------------
# omp / oh-my-pi — `omp`
# ---------------------------------------------------------------------------
# UNKNOWN. omp has no conformance descriptor and its only real-CLI file is a
# `--help` smoke script that is not even in the test glob, so nothing in this
# repository records how the CLI authenticates. Tell me how you log it in and
# I will replace this with the real variable.
OMP_API_KEY=

# ---------------------------------------------------------------------------
# Electron end-to-end, real CLIs (opt-in, separate from conformance)
# ---------------------------------------------------------------------------
# These drive the built app rather than the extension runtime. They are the
# layer that asserts rows in the Agents pane.
#
# Do not run these directly on a developer host: `npm run test:e2e` isolates
# Electron, Chromium and Xvfb in Docker. Run on the host and the terminal's
# login shell re-resolves PATH, so a stub CLI loses to a real one already
# installed and the test silently drives the wrong binary.
TERMINAY_REAL_CLAUDE_CODE_E2E=
TERMINAY_REAL_CODEX_E2E=
