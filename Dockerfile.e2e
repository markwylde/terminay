FROM node:24.14.0-bookworm-slim

ENV CI=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_WORKERS=1

WORKDIR /workspace

RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential ca-certificates git python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node apps/terminay-desktop/package.json apps/terminay-desktop/package.json
COPY --chown=node:node apps/terminay-server/package.json apps/terminay-server/package.json
COPY --chown=node:node apps/terminay-web/package.json apps/terminay-web/package.json
COPY --chown=node:node packages/client-core/package.json packages/client-core/package.json
COPY --chown=node:node packages/extension-api/package.json packages/extension-api/package.json
COPY --chown=node:node packages/protocol-conformance/package.json packages/protocol-conformance/package.json
COPY --chown=node:node packages/protocol/package.json packages/protocol/package.json
COPY --chown=node:node packages/responsive-ui/package.json packages/responsive-ui/package.json
COPY --chown=node:node packages/server-core/package.json packages/server-core/package.json
COPY --chown=node:node scripts/ensure-node-pty-helper-mode.mjs scripts/ensure-node-pty-helper-mode.mjs

RUN mkdir -p /ms-playwright \
    && chown node:node /workspace /ms-playwright

USER node
RUN npm ci \
    && node node_modules/electron/install.js \
    && npx playwright install chromium

USER root
RUN npx playwright install-deps chromium

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgtk-3-0 libxss1 xauth \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=node:node . .

USER node
RUN npm run build:app

ENTRYPOINT ["sh", "scripts/support/e2e-container-entrypoint.sh"]
