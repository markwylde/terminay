# The oldest GNU/Linux host Terminay supports (ADR-0077): glibc 2.31 with only
# the shared libraries Electron links. It has no Node, npm, or compiler, so an
# artifact probed here runs on its own runtime and its own native files. The
# base is pinned by digest and must be LINUX_FLOOR_RUNTIME_IMAGE in
# scripts/linux-glibc-floor.mjs.
FROM debian:bullseye-slim@sha256:e5b6442dd2e9684cf5e87d8338b5968f3b348636fc0be6d7850a381e3731a2bd

# Packages come from the Debian snapshot this image was built from, which the
# image names in its own sources. The live bullseye mirrors are past end of
# life and drop files their indexes still list; the snapshot is fixed.
RUN sed -i -e 's|^deb |# deb |' -e 's|^# deb http://snapshot|deb http://snapshot|' /etc/apt/sources.list \
    && grep -q '^deb http://snapshot\.debian\.org/' /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install --yes --no-install-recommends \
       libasound2 libatk-bridge2.0-0 libatk1.0-0 libcups2 libdbus-1-3 libdrm2 \
       libgbm1 libgtk-3-0 libnss3 libxcomposite1 libxdamage1 libxkbcommon0 \
       libxrandr2 libxss1 libxtst6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/sh probe \
    && install -d -o probe -g probe /probe

USER probe
WORKDIR /home/probe
