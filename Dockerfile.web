# syntax=docker/dockerfile:1.7

FROM node:24.14.0-bookworm-slim AS build
WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/terminay-desktop/package.json ./apps/terminay-desktop/package.json
COPY apps/terminay-server/package.json ./apps/terminay-server/package.json
COPY apps/terminay-web/package.json ./apps/terminay-web/package.json
COPY packages/client-core/package.json ./packages/client-core/package.json
COPY packages/protocol/package.json ./packages/protocol/package.json
COPY packages/protocol-conformance/package.json ./packages/protocol-conformance/package.json
COPY packages/responsive-ui/package.json ./packages/responsive-ui/package.json
COPY packages/server-core/package.json ./packages/server-core/package.json

RUN --mount=type=cache,id=terminay-npm-cache-node24,target=/root/.npm,sharing=locked \
  npm ci --ignore-scripts

COPY tsconfig.base.json tsconfig.json tsconfig.node.json tsconfig.web.json vite.web.config.ts web.html remote.html ./
COPY scripts/build-ui-bundle-manifest.mjs ./scripts/build-ui-bundle-manifest.mjs
COPY public ./public
COPY src ./src
COPY apps ./apps
COPY packages ./packages

RUN npm run build:shared \
  && npm run build --workspace @terminay/web \
  && npm run typecheck:web \
  && npm run build:web

FROM nginx:1.27-alpine AS runtime
COPY docker/05-terminay-resolver.envsh /docker-entrypoint.d/05-terminay-resolver.envsh
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx.web.conf /etc/nginx/templates/default.conf.template
COPY --from=build /workspace/dist-web/ /usr/share/nginx/html/
RUN chmod +x /docker-entrypoint.d/05-terminay-resolver.envsh \
  && chown -R nginx:nginx /usr/share/nginx/html

ENV NGINX_ENVSUBST_OUTPUT_DIR=/tmp

EXPOSE 8080
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O - http://127.0.0.1:8080/healthz | grep -q '^ok$'
