{
  "name": "@terminay/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Terminay's thin browser connection-host boundary.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@terminay/client-core": "1.0.0",
    "@terminay/protocol": "1.0.0",
    "@terminay/ui-bundle": "1.0.0",
    "@terminay/responsive-ui": "1.0.0",
    "@terminay/server-core": "1.0.0"
  },
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-workspace-graph.mjs --target @terminay/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  }
}
