#!/bin/sh
# Adds `--label terminay.bot=$TERMINAY_BOT_ID` to every container this CLI creates,
# so the bot's Containers view can list them. Best effort: a bot can bypass it.
real=/usr/libexec/docker-real
if [ -n "${TERMINAY_BOT_ID:-}" ]; then
  case "$1" in
    run|create)
      sub="$1"; shift
      exec "$real" "$sub" --label "terminay.bot=${TERMINAY_BOT_ID}" "$@" ;;
    container)
      case "$2" in
        run|create)
          sub="$2"; shift 2
          exec "$real" container "$sub" --label "terminay.bot=${TERMINAY_BOT_ID}" "$@" ;;
      esac ;;
  esac
fi
exec "$real" "$@"
