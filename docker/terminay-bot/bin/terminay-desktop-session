#!/usr/bin/env bash
# The bot's desktop: the shared Terminay desktop session, with the bot's menu
# entries and its desktop-control service.
# VNC/bootstrap/browser ownership stays with terminay-init.
set -euo pipefail
case "${1:-run}" in
 browser) export DISPLAY=:1; exec terminay-browser open "${2:-about:blank}" ;;
 terminal) export DISPLAY=:1; cd /home/bot; exec xfce4-terminal --disable-server --working-directory /home/bot -x bash -l ;;
 run) ;;
 *) exit 2 ;;
esac
export TERMINAY_DESKTOP_DISPLAY=:1
export TERMINAY_DESKTOP_HOME=/home/bot
export TERMINAY_DESKTOP_STATE_DIR=/tmp/terminay-desktop
export TERMINAY_DESKTOP_LAUNCHERS=/usr/local/share/terminay/desktop/launchers
export TERMINAY_DESKTOP_SERVICES=/usr/local/share/terminay/desktop/services
export TERMINAY_DESKTOP_BUS_FILE=/run/terminay/desktop/bus
exec /usr/local/lib/terminay/terminay-desktop-session
