{
  "name": "terminay-agent-grok",
  "version": "0.1.0",
  "description": "Official Grok CLI agent-status extension for Terminay",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terminay/terminay.git",
    "directory": "extensions/agent-grok"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run compile && node --test test/*.test.mjs",
    "test:ci": "node --test test/*.test.mjs",
    "test:compat": "npm run compile && node --test test/compatibility.test.mjs",
    "test:packed": "npm run compile && node --test test/packed.test.mjs",
    "test:real-cli": "npm run compile && node test/real-cli-smoke.mjs"
  },
  "peerDependencies": {
    "@terminay/extension-api": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "@terminay/extension-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@terminay/extension-api": "^1.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "terminay": {
    "manifestVersion": 1,
    "id": "com.terminay.agent.grok",
    "displayName": "Grok",
    "description": "Shows process-bound Grok CLI sessions in Terminay's Agents panel.",
    "api": "^1.2.0",
    "engines": {
      "terminay": ">=1.0.0",
      "node": ">=24"
    },
    "entrypoint": "dist/index.js",
    "platforms": ["darwin", "linux"],
    "permissions": ["agent-observation"],
    "contributes": {
      "agentProviders": [{
        "id": "com.terminay.agent.grok/cli",
        "displayName": "Grok",
        "description": "Grok CLI event-journal lifecycle observation.",
        "icon": "terminal",
        "processMatchers": [{ "executableName": "grok" }],
        "mappings": [{ "mappingVersion": "0.1", "providerVersionRange": ">=1.0.0" }],
        "requiredEnvironmentVariables": ["GROK_HOME"],
        "requiredEnvironmentCapabilities": ["process-observation", "filesystem-observation", "agent-journal"]
      }]
    }
  }
}
