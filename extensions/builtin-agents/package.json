{
	"name": "terminay-builtin-agents",
	"version": "0.1.0",
	"description": "Official coding-agent status and MCP registration extension for Terminay",
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/terminay/terminay.git",
		"directory": "extensions/builtin-agents"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./mcp": {
			"types": "./dist/mcp/index.d.ts",
			"import": "./dist/mcp/index.js",
			"default": "./dist/mcp/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"compile": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "npm run compile && node --test test/*.test.mjs",
		"test:ci": "node --test test/*.test.mjs",
		"test:packed": "npm run compile && node --test test/packed.test.mjs"
	},
	"dependencies": {
		"@markwylde/all-your-agents": "1.4.4"
	},
	"peerDependencies": {
		"@terminay/extension-api": "^3.3.0"
	},
	"peerDependenciesMeta": {
		"@terminay/extension-api": {
			"optional": true
		}
	},
	"devDependencies": {
		"@terminay/extension-api": "^3.3.0",
		"@types/node": "^24.0.0",
		"typescript": "^7.0.2"
	},
	"terminay": {
		"manifestVersion": 1,
		"id": "com.terminay.builtin-agents",
		"displayName": "Built-in Agents",
		"description": "Shows Claude Code, Codex, Grok, and oh-my-pi sessions in the Agents panel, registers the Terminay MCP server with coding-agent CLIs, runs Claude Code and Codex chats, and starts Claude Code and Codex in new terminals.",
		"api": "^3.3.0",
		"engines": {
			"terminay": ">=1.0.0",
			"node": ">=24"
		},
		"entrypoint": "dist/index.js",
		"platforms": [
			"darwin",
			"linux"
		],
		"permissions": [
			"agent-observation",
			"mcp-registration",
			"agent-chat",
			"agent-launch"
		],
		"contributes": {
			"agentSessionSources": [
				{
					"id": "com.terminay.builtin-agents/agents",
					"displayName": "Built-in Agents",
					"description": "Live coding-agent sessions on this machine, detected by all-your-agents.",
					"platforms": [
						"darwin",
						"linux"
					],
					"harnesses": [
						{
							"id": "claude-code",
							"displayName": "Claude Code"
						},
						{
							"id": "codex",
							"displayName": "Codex"
						},
						{
							"id": "grok",
							"displayName": "Grok"
						},
						{
							"id": "oh-my-pi",
							"displayName": "oh-my-pi"
						}
					],
					"environmentVariables": [
						"CLAUDE_CONFIG_DIR",
						"CODEX_HOME",
						"GROK_HOME",
						"PI_CONFIG_DIR",
						"PI_CODING_AGENT_DIR",
						"XDG_DATA_HOME",
						"XDG_STATE_HOME",
						"SHELL",
						"TERMINAY_CLAUDE_CODE_COMMAND",
						"TERMINAY_CODEX_COMMAND"
					]
				}
			],
			"agentChatProviders": [
				{
					"id": "com.terminay.builtin-agents/claude-code",
					"displayName": "Claude Code",
					"description": "Chats with the Claude Code CLI installed on this server, confined to the Terminay MCP server.",
					"platforms": [
						"darwin",
						"linux"
					]
				},
				{
					"id": "com.terminay.builtin-agents/codex",
					"displayName": "Codex",
					"description": "Chats with the Codex CLI installed on this server, confined to the Terminay MCP server.",
					"platforms": [
						"darwin",
						"linux"
					]
				}
			],
			"terminalLaunchers": [
				{
					"id": "com.terminay.builtin-agents/launch-claude-code",
					"displayName": "Claude Code",
					"icon": "agent-claude-code",
					"platforms": [
						"darwin",
						"linux"
					],
					"harness": {
						"source": "com.terminay.builtin-agents/agents",
						"harness": "claude-code"
					}
				},
				{
					"id": "com.terminay.builtin-agents/launch-codex",
					"displayName": "Codex",
					"icon": "agent-codex",
					"platforms": [
						"darwin",
						"linux"
					],
					"harness": {
						"source": "com.terminay.builtin-agents/agents",
						"harness": "codex"
					}
				}
			],
			"mcpInstallTargets": [
				{
					"id": "com.terminay.builtin-agents/claude-code",
					"displayName": "Claude Code"
				},
				{
					"id": "com.terminay.builtin-agents/codex",
					"displayName": "Codex"
				},
				{
					"id": "com.terminay.builtin-agents/cursor",
					"displayName": "Cursor CLI"
				},
				{
					"id": "com.terminay.builtin-agents/gemini",
					"displayName": "Gemini CLI"
				},
				{
					"id": "com.terminay.builtin-agents/grok",
					"displayName": "Grok"
				},
				{
					"id": "com.terminay.builtin-agents/opencode",
					"displayName": "OpenCode"
				}
			]
		}
	}
}
