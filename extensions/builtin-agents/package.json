{
	"name": "terminay-builtin-agents",
	"version": "0.2.0",
	"description": "Official coding-agent status and MCP registration extension for Terminay",
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/terminay/terminay.git",
		"directory": "extensions/builtin-agents"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./mcp": {
			"types": "./dist/mcp/index.d.ts",
			"import": "./dist/mcp/index.js",
			"default": "./dist/mcp/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"compile": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "npm run compile && node --test --test-force-exit --test-timeout=120000 test/*.test.mjs",
		"test:ci": "node --test --test-force-exit --test-timeout=120000 test/*.test.mjs",
		"test:packed": "npm run compile && node --test --test-force-exit --test-timeout=120000 test/packed.test.mjs"
	},
	"dependencies": {
		"@markwylde/all-your-agents": "1.4.4"
	},
	"peerDependencies": {
		"@terminay/extension-api": "^3.7.0"
	},
	"peerDependenciesMeta": {
		"@terminay/extension-api": {
			"optional": true
		}
	},
	"devDependencies": {
		"@terminay/extension-api": "^3.7.0",
		"@types/node": "^24.19.2",
		"typescript": "^7.0.2"
	},
	"terminay": {
		"manifestVersion": 1,
		"id": "com.terminay.builtin-agents",
		"displayName": "Built-in Agents",
		"description": "Shows Claude Code, Codex, Grok, and oh-my-pi sessions in the Agents panel, registers the Terminay MCP server with coding-agent CLIs, runs Claude Code and Codex chats, starts Claude Code and Codex in new terminals, and runs Codex without its shared background server in Terminay terminals.",
		"api": "^3.7.0",
		"engines": {
			"terminay": ">=1.0.0",
			"node": ">=24"
		},
		"entrypoint": "dist/index.js",
		"platforms": [
			"darwin",
			"linux"
		],
		"permissions": [
			"agent-observation",
			"mcp-registration",
			"agent-chat",
			"agent-launch",
			"terminal-command-defaults",
			"agent-bots"
		],
		"contributes": {
			"agentSessionSources": [
				{
					"id": "com.terminay.builtin-agents/agents",
					"displayName": "Built-in Agents",
					"description": "Live coding-agent sessions on this machine, detected by all-your-agents.",
					"platforms": [
						"darwin",
						"linux"
					],
					"harnesses": [
						{
							"id": "claude-code",
							"displayName": "Claude Code"
						},
						{
							"id": "codex",
							"displayName": "Codex"
						},
						{
							"id": "grok",
							"displayName": "Grok"
						},
						{
							"id": "oh-my-pi",
							"displayName": "oh-my-pi"
						}
					],
					"environmentVariables": [
						"CLAUDE_CONFIG_DIR",
						"CODEX_HOME",
						"GROK_HOME",
						"PI_CONFIG_DIR",
						"PI_CODING_AGENT_DIR",
						"XDG_DATA_HOME",
						"XDG_STATE_HOME",
						"SHELL",
						"TERMINAY_CLAUDE_CODE_COMMAND",
						"TERMINAY_CODEX_COMMAND"
					]
				}
			],
			"agentChatProviders": [
				{
					"id": "com.terminay.builtin-agents/claude-code",
					"displayName": "Claude Code",
					"description": "Chats with the Claude Code CLI installed on this server, confined to the Terminay MCP server.",
					"platforms": [
						"darwin",
						"linux"
					]
				},
				{
					"id": "com.terminay.builtin-agents/codex",
					"displayName": "Codex",
					"description": "Chats with the Codex CLI installed on this server, confined to the Terminay MCP server.",
					"platforms": [
						"darwin",
						"linux"
					]
				}
			],
			"terminalLaunchers": [
				{
					"id": "com.terminay.builtin-agents/launch-claude-code",
					"displayName": "Claude Code",
					"icon": "agent-claude-code",
					"initialPrompt": "positional",
					"platforms": [
						"darwin",
						"linux"
					],
					"harness": {
						"source": "com.terminay.builtin-agents/agents",
						"harness": "claude-code"
					}
				},
				{
					"id": "com.terminay.builtin-agents/launch-codex",
					"displayName": "Codex",
					"icon": "agent-codex",
					"initialPrompt": "positional",
					"platforms": [
						"darwin",
						"linux"
					],
					"harness": {
						"source": "com.terminay.builtin-agents/agents",
						"harness": "codex"
					}
				}
			],
			"terminalCommandDefaults": [
				{
					"id": "com.terminay.builtin-agents/codex-no-daemon",
					"command": "codex",
					"harness": {
						"source": "com.terminay.builtin-agents/agents",
						"harness": "codex"
					}
				}
			],
			"mcpInstallTargets": [
				{
					"id": "com.terminay.builtin-agents/claude-code",
					"displayName": "Claude Code"
				},
				{
					"id": "com.terminay.builtin-agents/codex",
					"displayName": "Codex"
				},
				{
					"id": "com.terminay.builtin-agents/cursor",
					"displayName": "Cursor CLI"
				},
				{
					"id": "com.terminay.builtin-agents/gemini",
					"displayName": "Gemini CLI"
				},
				{
					"id": "com.terminay.builtin-agents/grok",
					"displayName": "Grok"
				},
				{
					"id": "com.terminay.builtin-agents/opencode",
					"displayName": "OpenCode"
				}
			],
			"botAgents": [
				{
					"id": "com.terminay.builtin-agents/claude-code",
					"displayName": "Claude Code",
					"imageInstall": {
						"npm": [
							"@anthropic-ai/claude-code@2.1.312"
						]
					},
					"deviceSignIn": {
						"command": {
							"executable": "claude",
							"args": [
								"auth",
								"login",
								"--claudeai"
							]
						},
						"label": "Sign in with Claude",
						"help": "Sign in with your Claude subscription. Open the link shown below in your browser, then paste the returned authorization code into this terminal if prompted.",
						"signOutCommand": {
							"executable": "claude",
							"args": [
								"auth",
								"logout"
							]
						},
						"statusCommand": {
							"executable": "claude",
							"args": [
								"auth",
								"status"
							]
						}
					},
					"credentialSecrets": [
						{
							"environmentVariable": "CLAUDE_CODE_OAUTH_TOKEN",
							"kind": "sign-in-token",
							"label": "Sign-in token",
							"help": "Run claude setup-token to obtain a sign-in token."
						},
						{
							"environmentVariable": "ANTHROPIC_API_KEY",
							"kind": "api-key",
							"label": "API key",
							"help": "Create an API key in the Anthropic Console."
						}
					],
					"autonomousOnly": false,
					"launchEnvironment": {
						"CLAUDE_CODE_MAX_RETRIES": "0",
						"CLAUDE_CODE_SHELL_PREFIX": "/usr/local/bin/terminay-tool-shell"
					},
					"nativeDriver": "claude-code-cli",
					"runtimeVersion": "2.1.312",
					"runtimeProtocol": "native-cli-v1"
				},
				{
					"id": "com.terminay.builtin-agents/codex",
					"displayName": "Codex",
					"imageInstall": {
						"npm": [
							"@openai/codex@0.165.0"
						]
					},
					"deviceSignIn": {
						"command": {
							"executable": "codex",
							"args": [
								"login",
								"--device-auth"
							]
						},
						"label": "Sign in with ChatGPT",
						"help": "Sign in with your ChatGPT subscription. Codex shows a link and a code to approve in your browser.",
						"signOutCommand": {
							"executable": "codex",
							"args": [
								"logout"
							]
						},
						"statusCommand": {
							"executable": "codex",
							"args": [
								"login",
								"status"
							]
						},
						"configFiles": [
							{
								"path": ".codex/config.toml",
								"contents": "cli_auth_credentials_store = \"file\"\n\n[shell_environment_policy]\nexclude = [\"CODEX_API_KEY\", \"OPENAI_API_KEY\"]\n"
							}
						]
					},
					"credentialSecrets": [
						{
							"environmentVariable": "CODEX_API_KEY",
							"kind": "api-key",
							"label": "API key",
							"help": "Create an API key in the OpenAI API dashboard."
						}
					],
					"autonomousOnly": true,
					"botConfigFiles": [
						{
							"path": ".codex/config.toml",
							"contents": "cli_auth_credentials_store = \"ephemeral\"\n\n[shell_environment_policy]\nexclude = [\"CODEX_API_KEY\", \"OPENAI_API_KEY\"]\n"
						}
					],
					"nativeDriver": "codex-cli",
					"runtimeVersion": "0.165.0",
					"runtimeProtocol": "native-cli-v1"
				}
			]
		}
	}
}
