{
  "name": "@terminay/agent-conformance",
  "version": "0.1.0",
  "description": "Real-CLI conformance harness for Terminay agent provider extensions",
  "type": "module",
  "private": true,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=24" },
  "dependencies": {
    "@terminay/extension-api": "^1.2.0",
    "@terminay/server-core": "^1.0.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^6.0.0" }
}
