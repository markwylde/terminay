{
  "name": "terminay-example-provider",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "exports": { ".": "./extension.js" },
  "terminay": {
    "manifestVersion": 1,
    "id": "dev.example.basic",
