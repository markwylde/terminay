{
	"name": "terminay-example-bot-agent",
	"version": "1.0.0",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": "./extension.js"
	},
	"peerDependencies": {
		"@terminay/extension-api": "^3.5.0"
	},
	"terminay": {
		"manifestVersion": 1,
		"id": "com.example.bot",
		"displayName": "Example bot agent",
		"api": "^3.6.0",
		"engines": {
			"terminay": ">=1.0.0",
			"node": ">=24"
		},
		"entrypoint": "extension.js",
		"permissions": [
			"agent-bots"
		],
		"contributes": {
			"botAgents": [
				{
					"id": "com.example.bot/example",
					"displayName": "Example ACP agent",
					"imageInstall": {
						"npm": [
							"@openai/codex@0.165.0"
						]
					},
					"deviceSignIn": {
						"command": {
							"executable": "codex",
							"args": [
								"login",
								"--device-auth"
							]
						},
						"signOutCommand": {
							"executable": "codex",
							"args": [
								"logout"
							]
						},
						"label": "Sign in with ChatGPT",
						"help": "Approve the code in your browser.",
						"configFiles": [
							{
								"path": ".codex/config.toml",
								"contents": "cli_auth_credentials_store = \"file\"\n"
							}
						]
					},
					"credentialSecrets": [
						{
							"environmentVariable": "CODEX_API_KEY",
							"kind": "api-key",
							"label": "Example API key",
							"help": "Create an API key in your Example account."
						}
					],
					"autonomousOnly": true,
					"botConfigFiles": [
						{
							"path": ".codex/config.toml",
							"contents": "cli_auth_credentials_store = \"ephemeral\"\n[shell_environment_policy]\nexclude = [\"CODEX_API_KEY\", \"OPENAI_API_KEY\"]\n"
						}
					],
					"launchEnvironment": {
						"EXAMPLE_MAX_RETRIES": "0"
					},
					"runtimeProtocol": "native-cli-v1",
					"nativeDriver": "codex-cli",
					"runtimeVersion": "0.165.0"
				}
			]
		}
	}
}
