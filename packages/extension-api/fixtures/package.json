{
  "name": "@terminay/extension-conformance-fixture",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/extension.js"
  },
  "terminay": {
    "manifestVersion": 1,
    "id": "dev.terminay.fixture",
    "displayName": "Fixture Agent Extension",
    "description": "A portable extension host fixture.",
    "api": "^2.0.0",
    "engines": {
      "terminay": ">=1.0.0",
      "node": ">=22"
    },
    "entrypoint": "dist/extension.js",
    "permissions": ["agent-observation"],
    "contributes": {
      "agentProviders": [{
        "id": "dev.terminay.fixture/agent",
        "displayName": "Fixture Agent",
        "processMatchers": [{ "executableName": "fixture-agent" }]
      }]
    }
  }
}
